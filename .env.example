# === RepoLens Environment Configuration ===
# Copy this file to .env.local and configure as needed

# === GitHub Integration (Optional) ===
# GitHub Personal Access Token - increases rate limit from 60 to 5000 requests/hour
# Get yours at: https://github.com/settings/tokens
# No scopes needed for public repositories
VITE_GITHUB_TOKEN=
VITE_GITHUB_API_BASE=https://api.github.com
VITE_GITHUB_RAW_BASE=https://raw.githubusercontent.com

# === LLM Provider Configuration ===
# Primary LLM Provider: 'ollama' (local) or 'gemini' (cloud)
VITE_LLM_PROVIDER=ollama
VITE_DEFAULT_LLM_PROVIDER=ollama

# === Ollama Configuration (Local AI - Free, Private, Fast) ===
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_MODEL=qwen2.5:3b
VITE_OLLAMA_ENABLED=true

# === Gemini Configuration (Google Cloud AI - Optional) ===
# Get your API key at: https://aistudio.google.com/app/apikey
# The key should start with "AIza..."
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-1.5-flash-latest
VITE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# === Voice Configuration ===
VITE_VOICE_ENABLED=true
VITE_VOICE_RATE=0.95
VITE_VOICE_PITCH=1.0
VITE_VOICE_VOLUME=1.0

# === Application Settings ===
VITE_APP_NAME=RepoLens
VITE_APP_VERSION=2.4.0
VITE_APP_DESCRIPTION=Repository Analysis & Intelligence Platform

# === UI Configuration ===
VITE_DEFAULT_VIEW=overview
VITE_RIGHT_PANEL_DEFAULT=symbols
VITE_ANIMATION_DURATION=300

# === Analysis Limits ===
VITE_MAX_FILES_TO_ANALYZE=50
VITE_MAX_FILE_SIZE_KB=500
VITE_MAX_LINES_OF_CODE=1000000
VITE_API_TIMEOUT=30000

# === Chat & AI Configuration ===
VITE_DEFAULT_AGENT_ID=orchestrator
VITE_MAX_CHAT_MESSAGES=100
VITE_CHAT_RESPONSE_DELAY=350

# === Security Configuration ===
VITE_RATE_LIMIT_WINDOW=60000
VITE_RATE_LIMIT_MAX=100

# === Development Configuration ===
# Only used during local development
VITE_DEV_SERVER_PORT=4000
VITE_DEV_CLIENT_PORT=5173
VITE_CLIENT_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000
VITE_DEFAULT_IP=127.0.0.1
