# Application Configuration
VITE_APP_NAME=RepoLens
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Repository Analysis Tool

# API Configuration
VITE_GITHUB_API_BASE=https://api.github.com
VITE_GITHUB_RAW_BASE=https://raw.githubusercontent.com
VITE_API_TIMEOUT=30000
VITE_GITHUB_TOKEN=

# LLM Provider Configuration
VITE_DEFAULT_LLM_PROVIDER=ollama

# Ollama Configuration
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_MODEL=qwen2.5:3b

# Gemini Configuration
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-1.5-flash-8b
VITE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Repository Analysis Settings
VITE_MAX_FILES_TO_ANALYZE=50
VITE_MAX_FILE_SIZE_KB=500
VITE_MAX_LINES_OF_CODE=1000000

# UI Configuration
VITE_DEFAULT_VIEW=overview
VITE_RIGHT_PANEL_DEFAULT=symbols
VITE_ANIMATION_DURATION=300

# Development Configuration
VITE_DEV_SERVER_PORT=4000
VITE_DEV_CLIENT_PORT=5173
VITE_CLIENT_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000
VITE_DEFAULT_IP=127.0.0.1

# Chat & AI Configuration
VITE_DEFAULT_CHAT_AGENT=orchestrator
VITE_MAX_CHAT_MESSAGES=100
VITE_CHAT_RESPONSE_DELAY=350
VITE_WELCOME_MESSAGE=Engineering Intelligence ready for analysis.
VITE_WELCOME_MESSAGE_ID=msg_welcome
VITE_REVIEW_NOT_RUN_MESSAGE=Review not yet run. Click "Run 5-Agent Review" to analyze the repository.

# Voice Configuration
VITE_VOICE_ENABLED=true
VITE_VOICE_RATE=1.0
VITE_VOICE_PITCH=1.0
VITE_VOICE_VOLUME=0.8

# Security Configuration
VITE_RATE_LIMIT_WINDOW=60000
VITE_RATE_LIMIT_MAX=100

# Message Templates
VITE_TIMESTAMP_JUST_NOW=Just now
VITE_TIMESTAMP_LOADING=Loading...
VITE_ERROR_REPO_NOT_FOUND=not found or is private.
VITE_ERROR_LOAD_FAILED=Failed to load file from GitHub
VITE_ERROR_REVIEW_FAILED=Review failed. Please ensure your LLM service is configured.
VITE_ERROR_LLM_NOT_CONFIGURED=Please ensure Ollama is running or Gemini API key is configured.
VITE_SUCCESS_REVIEW_COMPLETE=Review completed successfully
VITE_SUCCESS_CONFLICT_RESOLVED=Conflict resolved
VITE_SUCCESS_FIX_APPLIED=Fix applied successfully
VITE_PLACEHOLDER_NO_DESCRIPTION=No description provided
VITE_PLACEHOLDER_NO_CONTENT=No content available
VITE_PLACEHOLDER_UNKNOWN_ERROR=Unknown error

# Agent Configuration
VITE_DEFAULT_AGENT_ID=orchestrator
VITE_ORCHESTRATOR_NAME=Review Orchestrator
VITE_ORCHESTRATOR_SHORT_NAME=Orchestrator
VITE_ORCHESTRATOR_AVATAR=👑

# Feature Messages
VITE_BRANCH_COMPARISON_MESSAGE=Branch comparison feature requires Git integration. Currently showing empty comparison.
VITE_CHANGE_PLAN_MESSAGE=Change plan generation requires LLM integration. Feature in development.
